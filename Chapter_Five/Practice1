# Initialize a sample dictionary
my_dict = {"name": "Alice", 
           "age": 25, 
           "city": "Dhaka"}

# 1. .keys(): Returns a view of all keys
keys = my_dict.keys()
print(f"Keys: {keys}") 
# Output: Keys: dict_keys(['name', 'age', 'city'])

# 2. .values(): Returns a view of all values
values = my_dict.values()
print(f"Values: {values}")
# Output: Values: dict_values(['Alice', 25, 'Dhaka'])

# 3. .items(): Returns a view of all (key, value) pairs as tuples
items = my_dict.items()
print(f"Items: {items}")
# Output: Items: dict_items([('name', 'Alice'), ('age', 25), ('city', 'Dhaka')])

# 4. .get(key, default): Safely access a value without causing an error if the key is missing
age = my_dict.get("age")             # Exists
salary = my_dict.get("salary", 0)    # Missing, returns default (0)
print(f"Age: {age}, Salary: {salary}")
# Output: Age: 25, Salary: 0

# 5. .update(): Merges another dictionary or iterable into the current one
my_dict.update({"job": "Engineer", "age": 26})
print(f"Updated dict: {my_dict}")
# Output: Updated dict: {'name': 'Alice', 'age': 26, 'city': 'Dhaka', 'job': 'Engineer'}

# 6. .pop(key): Removes the specified key and returns its value
removed_value = my_dict.pop("city")
print(f"Removed: {removed_value}, Dict: {my_dict}")
# Output: Removed: Dhaka, Dict: {'name': 'Alice', 'age': 26, 'job': 'Engineer'}

# 7. .popitem(): Removes and returns the last inserted key-value pair
last_item = my_dict.popitem()
print(f"Popped item: {last_item}, Dict: {my_dict}")
# Output: Popped item: ('job', 'Engineer'), Dict: {'name': 'Alice', 'age': 26}

# 8. .clear(): Removes all items from the dictionary
my_dict.clear()
print(f"Cleared dict: {my_dict}")
# Output: Cleared dict: {}
