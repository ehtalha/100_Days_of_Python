# funtions of set
# Initialize two sets
set_a = {1, 2, 3, 4}
set_b = {3, 4, 5, 6}

# 1. .add(): Adds an element to the set
set_a.add(5)
print(f"After add: {set_a}")
# Output: After add: {1, 2, 3, 4, 5}

# 2. .remove(): Removes a specific element. Raises KeyError if element not found.
set_a.remove(1)
print(f"After remove: {set_a}")
# Output: After remove: {2, 3, 4, 5}

# 3. .union() | : Returns a new set containing all elements from both sets
union_set = set_a.union(set_b)
print(f"Union: {union_set}")
# Output: Union: {2, 3, 4, 5, 6}

# 4. .intersection() & : Returns a new set containing only common elements
common = set_a.intersection(set_b)
print(f"Intersection: {common}")
# Output: Intersection: {3, 4, 5}

# 5. .difference() - : Returns elements in set_a that are NOT in set_b
diff = set_a.difference(set_b)
print(f"Difference: {diff}")
# Output: Difference: {2}

# 6. .issubset(): Checks if all elements of set_a are in set_b
print(f"Is subset: {{3, 4}}.issubset(set_b) -> {{3, 4}}.issubset(set_b)")
# Output: Is subset: True

# 7. .discard(): Similar to remove(), but does NOT raise an error if element is missing
set_a.discard(100)
print("Discard finished without error.")
